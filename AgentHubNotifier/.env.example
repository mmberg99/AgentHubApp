# AgentHub Notifier -- EXAMPLE configuration (placeholders only).
#
# This file is NOT read by the program. Nothing loads .env, because that would
# need a third-party package. It documents the environment variables that
# --send and --dry-run read, and shows their shape.
#
# To use these values, set them in your shell for the current session:
#
#   $env:AGENTHUB_ENDPOINT="https://relay.example.invalid/v1/events"
#   $env:AGENTHUB_AUTH_TOKEN="replace-with-a-real-secret"
#
# Never commit a real token. Never put a real token in this example file.
# .gitignore already excludes a real ".env".

# HTTPS endpoint of the relay service that forwards to the AgentHub iPhone app.
# Must be https:// -- plain http:// is refused and is never silently upgraded.
# The ".invalid" TLD below can never resolve, which is deliberate: this
# placeholder cannot accidentally send anything anywhere.
AGENTHUB_ENDPOINT=https://relay.example.invalid/v1/events

# Bearer token identifying this machine to the relay. FAKE PLACEHOLDER.
# Sent only in the Authorization header. Never logged, never printed, never
# included in the event body or in any error message.
AGENTHUB_AUTH_TOKEN=replace-me-with-a-real-token

# Seconds to wait before giving up on a delivery attempt. Optional.
# Default 5. Must be between 1 and 30.
AGENTHUB_TIMEOUT_SECONDS=5

# Kill switch. Set to 1 to make --send build and validate the event but send
# nothing. Useful for wiring up an agent before the relay exists.
AGENTHUB_OFFLINE=0

# ---------------------------------------------------------------------------
# AgentHub Mac bridge (used by the Claude Code hooks via agenthub-hook.py)
# ---------------------------------------------------------------------------
# Separate from the two variables above: that pair is for the future internet
# relay over HTTPS, this pair is for the bridge already running on your Mac.
#
# Must be http(s):// + a literal PRIVATE IP + /events. A hostname is refused,
# so no DNS lookup can point this anywhere; a public IP is refused outright.
AGENTHUB_MAC_ENDPOINT=http://192.168.1.50:8787/events

# Bearer token the Mac bridge expects. FAKE PLACEHOLDER.
# Sent only in the Authorization header. Never logged, never printed, never
# placed in settings.json, never committed.
AGENTHUB_BRIDGE_TOKEN=replace-me-with-your-bridge-token
